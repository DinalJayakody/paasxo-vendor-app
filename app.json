{
  "expo": {
    "name": "Paasxo Vendor",
    "slug": "paasxo-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#184E85"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "5",
      "bundleIdentifier": "com.paasxo.vendor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.paasxo.vendor",
      "adaptiveIcon": {
        "backgroundColor": "#184E85"
      }
    },
    "scheme": "paasxovendor",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Paasxo Vendor uses your photo library so you can add pictures and videos of your venue, training sessions and profile.",
          "cameraPermission": "Paasxo Vendor uses your camera so you can photograph your business registration or ID for verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Paasxo Vendor uses your location to pin your venue's exact spot on the map."
        }
      ],
      "expo-font",
      "expo-notifications"
    ]
  }
}
